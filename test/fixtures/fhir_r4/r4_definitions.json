{
  "_about": "Hand-written from the HL7 FHIR R4 (4.0.1) resource definitions: element lists, cardinality 1..* / 1..1 elements, required bindings, primitive-type regexes. Written by hand for Guardian Session 4 and NOT generated from the exporter. The official HL7 validator was not run (needs Java and package downloads); see SESSION-4-RESULT.md.",
  "resources": {
    "Patient": {
      "elements": ["id","meta","implicitRules","language","text","contained","extension","modifierExtension","identifier","active","name","telecom","gender","birthDate","deceasedBoolean","deceasedDateTime","address","maritalStatus","multipleBirthBoolean","multipleBirthInteger","photo","contact","communication","generalPractitioner","managingOrganization","link"],
      "required": []
    },
    "Observation": {
      "elements": ["id","meta","implicitRules","language","text","contained","extension","modifierExtension","identifier","basedOn","partOf","status","category","code","subject","focus","encounter","effectiveDateTime","effectivePeriod","effectiveTiming","effectiveInstant","issued","performer","valueQuantity","valueCodeableConcept","valueString","valueBoolean","valueInteger","valueRange","valueRatio","valueSampledData","valueTime","valueDateTime","valuePeriod","dataAbsentReason","interpretation","note","bodySite","method","specimen","device","referenceRange","hasMember","derivedFrom","component"],
      "required": ["status","code"]
    },
    "Provenance": {
      "elements": ["id","meta","implicitRules","language","text","contained","extension","modifierExtension","target","occurredPeriod","occurredDateTime","recorded","policy","location","reason","activity","agent","entity","signature"],
      "required": ["target","recorded","agent"]
    },
    "Bundle": {
      "elements": ["id","meta","implicitRules","language","identifier","type","timestamp","total","link","entry","signature"],
      "required": ["type"]
    }
  },
  "requiredBindings": {
    "Observation.status": ["registered","preliminary","final","amended","corrected","cancelled","entered-in-error","unknown"],
    "Bundle.type": ["document","message","transaction","transaction-response","batch","batch-response","history","searchset","collection"],
    "Provenance.entity.role": ["derivation","revision","quotation","source","removal"],
    "Patient.name.use": ["usual","official","temp","nickname","anonymous","old","maiden"],
    "Narrative.status": ["generated","extensions","additional","empty"]
  },
  "primitives": {
    "id": "^[A-Za-z0-9\\-\\.]{1,64}$",
    "code": "^[^\\s]+(\\s[^\\s]+)*$",
    "instant": "^([0-9]([0-9]([0-9][1-9]|[1-9]0)|[1-9]00)|[1-9]000)-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))$",
    "dateTime": "^([0-9]([0-9]([0-9][1-9]|[1-9]0)|[1-9]00)|[1-9]000)(-(0[1-9]|1[0-2])(-(0[1-9]|[1-2][0-9]|3[0-1])(T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00)))?)?)?$",
    "uri": "^\\S*$",
    "urnUuid": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "extensionValueTypes": {
    "valueString": "string",
    "valueCode": "code",
    "valueBoolean": "boolean",
    "valueInteger": "integer",
    "valueUnsignedInt": "unsignedInt",
    "valueDateTime": "dateTime"
  }
}
